{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0",

    "rootDir": "../../..",
    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../../../shared/*"]
    },

    "outDir": "./dist",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../../../shared/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
