{
  "private": true,
  "workspaces": [
    "modules/*/web",
    "modules/*/api"
  ],
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev:vox:api": "pnpm --filter ./modules/vox-observatory/api dev",
    "dev:vox:web": "pnpm --filter ./modules/vox-observatory/web dev",
    "dev:platform-shell": "pnpm --filter ./modules/platform-shell/web dev",
    "dev:coop-manager:api": "pnpm --filter ./modules/coop-manager/api dev",
    "dev:coop-manager:web": "pnpm --filter ./modules/coop-manager/web dev",
    "dev:coop-manager": "pnpm --parallel --filter ./modules/coop-manager/api --filter ./modules/coop-manager/web run dev",
    "dev:all": "pnpm --parallel --filter ./modules/vox-observatory/api --filter ./modules/vox-observatory/web --filter ./modules/platform-shell/web --filter ./modules/coop-manager/api --filter ./modules/coop-manager/web run dev",
    "dev": "pnpm run dev:all",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck"
  },
  "dependencies": {
    "@fastify/jwt": "^8.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "lucide-react": "^0.447.0",
    "next": "^15.5.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.5.0",
    "fastify": "^5.8.5",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
